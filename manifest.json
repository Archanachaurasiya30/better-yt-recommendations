{
  "manifest_version": 3,
  "name": "Better YT Homepage",
  "version": "1.0.1",
  "description": "Open YouTube Home on Your custom feed automatically.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
